# Copy to .env (git-ignored) and fill in.

# Postgres password for the local database (any random string).
POSTGRES_PASSWORD=change-me

# GitHub user whose stars are archived.
STARS_USERNAME=zorenkonte

# Classic personal access token. `read:user` is enough for public stars and
# your private star lists. Add the `repo` scope and set USE_AUTH_USER=true to
# also archive private repositories you starred. Leave empty to archive public
# stars only (no lists, 60 requests/hour unauthenticated).
STARS_TOKEN=
USE_AUTH_USER=

# Where and when the nightly run happens (local time in TZ).
TZ=Asia/Manila
ARCHIVE_AT=08:07
# Run an archive immediately when the container starts.
RUN_ON_START=true
# How many repos TODAY.md surfaces per run.
DAILY_COUNT=10

# Web reader bind. 0.0.0.0 = every interface on the Pi (LAN); 127.0.0.1 = this host only.
WEB_BIND=0.0.0.0
WEB_PORT=3000
